<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:UntilYouFall.Launcher.ViewModels"
  x:Class="UntilYouFall.Launcher.Views.ItemPicker"
>
  <StackPanel Spacing="6">
    <TextBox
      x:Name="Search"
      Width="360"
      HorizontalAlignment="Left"
      Watermark="Search items..."
      GotFocus="Search_GotFocus"
      PointerPressed="Search_PointerPressed"
      TextChanged="Search_TextChanged"
    />

    <Popup
      x:Name="Dropdown"
      PlacementTarget="{Binding #Search}"
      Placement="Bottom"
      IsLightDismissEnabled="True"
      OverlayDismissEventPassThrough="True"
    >
      <Border Background="#23262F" BorderBrush="#3A3E4C" BorderThickness="1" Width="360" MaxHeight="260">
        <ListBox x:Name="Matches" SelectionChanged="Matches_SelectionChanged" />
      </Border>
    </Popup>

    <TextBlock
      x:DataType="vm:OptionViewModel"
      Classes="secondary"
      Text="{Binding Summary}"
      IsVisible="{Binding HasTiers}"
    />

    <ItemsControl x:Name="Chips">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SelectedItem">
          <Border Background="#2B2F3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock
                Classes="secondary"
                Text="{Binding Tag}"
                IsVisible="{Binding HasTag}"
                VerticalAlignment="Center"
              />
              <Button Content="−" IsVisible="{Binding Counted}" Padding="6,0" Click="Minus_Click" />
              <TextBlock Text="{Binding Count}" IsVisible="{Binding Counted}" VerticalAlignment="Center" />
              <Button Content="+" IsVisible="{Binding Counted}" Padding="6,0" Click="Plus_Click" />
              <Button Content="×" Padding="6,0" Click="Remove_Click" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
