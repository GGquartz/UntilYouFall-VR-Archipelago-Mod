<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="UntilYouFall.Launcher.Views.ConnectView"
>
  <StackPanel Classes="page" Width="560" HorizontalAlignment="Left">
    <TextBlock Classes="heading" Text="Connect" />

    <TextBlock Text="Server" />
    <TextBox x:Name="Server" Text="archipelago.gg:" />

    <TextBlock Text="Slot name" />
    <TextBox x:Name="Slot" Text="Player1" />

    <TextBlock Text="Password (leave empty if none)" />
    <TextBox x:Name="Password" PasswordChar="●" />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" />
      <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" />
    </StackPanel>

    <TextBlock x:Name="Status" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
