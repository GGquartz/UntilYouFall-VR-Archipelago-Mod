<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="using:UntilYouFall.Launcher.Core"
  x:Class="UntilYouFall.Launcher.Views.InstallView"
  x:DataType="core:InstallEntry"
>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,*" Margin="14">
    <TextBlock Classes="heading" Text="Game folder" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
      <TextBox x:Name="GameDir" LostFocus="GameDir_LostFocus" />
      <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
      <Button Grid.Column="2" Content="Detect" Margin="8,0,0,0" Click="Detect_Click" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="2">
      <TextBlock x:Name="MelonStatus" />
      <TextBlock x:Name="ModStatus" />
    </StackPanel>

    <StackPanel x:Name="Actions" Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Install / Repair" Click="Install_Click" />
      <Button Content="Uninstall mod" Click="Uninstall_Click" />
      <Button Content="Refresh" Click="Refresh_Click" />
      <TextBlock
        x:Name="Ready"
        VerticalAlignment="Center"
        Margin="8,0,0,0"
        Foreground="{StaticResource SuccessBrush}"
      />
    </StackPanel>

    <Border
      x:Name="LinuxGuide"
      Grid.Row="4"
      IsVisible="False"
      Margin="0,12,0,0"
      Padding="10"
      BorderThickness="1"
      BorderBrush="{StaticResource GoldBrush}"
    >
      <StackPanel Spacing="6">
        <TextBlock Classes="heading" Text="Linux / Steam / Proton (experimental)" />
        <TextBlock TextWrapping="Wrap">
          1) Pick a Proton version for the game in Steam (Properties - Compatibility)
        </TextBlock>
        <TextBlock TextWrapping="Wrap">2) Click Install / Repair</TextBlock>
        <TextBlock TextWrapping="Wrap">
          3) Paste the launch option below into Until You Fall's Steam Properties - Launch Options
        </TextBlock>
        <TextBlock TextWrapping="Wrap">4) Start the game from Steam</TextBlock>
        <TextBlock TextWrapping="Wrap">5) Connect from the launcher once the game is at the main menu</TextBlock>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="LaunchOption" IsReadOnly="True" FontFamily="Consolas,DejaVu Sans Mono,Menlo,monospace" />
          <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Click="CopyLaunchOption_Click" />
        </Grid>
      </StackPanel>
    </Border>

    <ListBox x:Name="Files" Grid.Row="5" Margin="0,12,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:InstallEntry">
          <Grid ColumnDefinitions="*,120">
            <TextBlock Text="{Binding Relative}" />
            <TextBlock Grid.Column="1" Text="{Binding State}" Classes="secondary" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="6" Classes="heading" Text="Log" Margin="0,12,0,4" />
    <TextBox x:Name="Log" Grid.Row="7" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
  </Grid>
</UserControl>
