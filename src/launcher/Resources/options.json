  {
    "key": "starting_hands",
    "display": "Starting Hands",
    "help": "Choose which hands are available at the start",
    "type": "choice",
    "choices": [
      "both",
      "left_only",
      "right_only"
    ],
    "default": "right_only"
  },
  {
    "key": "early_hand",
    "display": "Early Hand",
    "help": "If starting with only one hand, make sure missing hand is available early",
    "type": "choice",
    "choices": [
      "first_25_percent_of_checks",
      "first_50_percent_of_checks",
      "unrestricted"
    ],
    "default": "first_50_percent_of_checks"
  },
  {
    "key": "weapon_supers",
    "display": "Weapon Supers",
    "help": "Unlock weapon supers together with weapons or as separate items",
    "type": "choice",
    "choices": [
      "unlocked_with_weapon",
      "separate_items"
    ],
    "default": "separate_items"
  },
  {
    "key": "stage_reward_checks",
    "display": "Stage Reward Checks Count",
    "help": "Clearing rooms has a chance to offer sequential AP checks",
    "type": "range",
    "min": 10,
    "max": 30,
    "default": 20
  },
  {
    "key": "trap_percent",
    "display": "Trap %",
    "help": "Percentage of filler slots replaced with traps",
    "type": "range",
    "min": 0,
    "max": 100,
    "default": 10
  },
  {
    "key": "trap_weights",
    "display": "Trap Weights",
    "help": "Relative share of each trap type",
    "type": "weights",
    "default": {
      "Enemy Spawn Trap": 20,
      "Elite Encounter Trap": 20,
      "Dodge Only Trap": 20,
      "Exhaustion Trap": 20,
      "Cursed Trap": 20
