  {
    "key": "second_starting_weapon",
    "display": "Second Starting Weapon",
    "help": "Optional, must be different than the first weapon",
    "type": "choice",
    "choices": [
      "none",
      "spellswords_charm",
      "knight_blooded_crest",
      "engraved_arming_sword",
