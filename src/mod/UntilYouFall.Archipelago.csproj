<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\UntilYouFall</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource
      Include="Crushables/Assets/ap-logo.meshbin"
      LogicalName="UntilYouFall.Crushables.ApLogo.meshbin"
    />
    <EmbeddedResource Include="../apworld/until_you_fall/weapons.json" LogicalName="UntilYouFall.Weapons.json" />
    <EmbeddedResource
      Include="../apworld/until_you_fall/weapon_abilities.json"
      LogicalName="UntilYouFall.WeaponAbilities.json"
    />
    <EmbeddedResource
      Include="../apworld/until_you_fall/starting_traits.json"
      LogicalName="UntilYouFall.StartingTraits.json"
    />
    <EmbeddedResource
      Include="../../assets/quest-icons/*.jpg"
      LogicalName="UntilYouFall.QuestIcons.%(Filename)%(Extension)"
    />
    <EmbeddedResource Include="../apworld/until_you_fall/quests.json" LogicalName="UntilYouFall.Quests.json" />
    <EmbeddedResource Include="../apworld/until_you_fall/enemies.json" LogicalName="UntilYouFall.Enemies.json" />
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSG.GlobalEvents">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSG.GlobalEvents.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSchellGames.Vulpine.Runtime">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSchellGames.Vulpine.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSG.Core">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSG.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSG.Save">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSG.Save.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSG.Vignettitor">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSG.Vignettitor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSG.XR">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSG.XR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSteamVR">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSteamVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSteamVR_Actions">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSteamVR_Actions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckMelonLoader" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\MelonLoader\net6\MelonLoader.dll')" Text="MelonLoader.dll was not found" />
  </Target>
</Project>
